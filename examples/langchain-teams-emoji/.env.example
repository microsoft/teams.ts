PORT=3978

# Microsoft Foundry / Azure OpenAI (OpenAI-compatible endpoint)
# Use OPENAI_API_KEY (not AZURE_OPENAI_API_KEY) to stay in standard mode
OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1
OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1-mini

# Teams bot credentials — from: teams app create --name "..." --endpoint "..." --json
CLIENT_ID=<bot-client-id>
CLIENT_SECRET=<bot-client-secret>
TENANT_ID=<your-tenant-id>
