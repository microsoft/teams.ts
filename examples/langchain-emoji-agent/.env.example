PORT=3978

# Direct OpenAI-compatible endpoint for Microsoft Foundry / Azure OpenAI
# Use OPENAI_API_KEY (not AZURE_OPENAI_API_KEY) to stay in standard mode —
# @langchain/openai switches to a different Azure code path otherwise.
OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1
OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1
