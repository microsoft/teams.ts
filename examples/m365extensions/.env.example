# Copy this file to .env and fill in your bot's credentials.
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=
PORT=3978

# OAuth handlers for the sign-in demo (whoami / mail / signout). Each name maps to an
# Azure Bot Service OAuth connection; see README.md → Multi Authentication.
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__graphuser__SETTINGS__AZUREBOTOAUTHCONNECTIONNAME=graphuser
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__graphmail__SETTINGS__AZUREBOTOAUTHCONNECTIONNAME=graphmail
